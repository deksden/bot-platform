{
  "name": "@dd-bot-platform/core",
  "description": "Framework-safe execution kernel contracts and helpers for bot-platform.",
  "version": "0.1.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo"
  ],
  "keywords": [
    "dd-bot-platform",
    "bot-platform",
    "framework",
    "core",
    "execution-kernel"
  ],
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/deksden/bot-platform.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/deksden/bot-platform",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepack": "pnpm build",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --pretty false"
  }
}
